{
  "name": "mizurisu-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Mizurisu Agent — 面向 Mizurisu / New-API 的纯本机跨形态三端 Office Agent 工作台（Web / Desktop / Mobile）",
  "license": "MIT",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "pnpm --filter @mizurisu-agent/app dev",
    "build": "pnpm --filter @mizurisu-agent/app build",
    "typecheck": "pnpm --filter @mizurisu-agent/app typecheck",
    "test": "pnpm --filter @mizurisu-agent/app test",
    "dev:desktop": "pnpm --filter @mizurisu-agent/desktop dev",
    "build:desktop": "pnpm --filter @mizurisu-agent/desktop build",
    "sync:mobile": "pnpm --filter @mizurisu-agent/app build && pnpm --filter @mizurisu-agent/mobile sync"
  }
}
